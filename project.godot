; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TTP Editor"
run/main_scene="uid://dumrck1gsfcm7"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.047557652, 0.047557652, 0.04755763, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://bybqthnjckb1k"
config/icon="uid://ct2ys4wig2wa0"

[autoload]

WebFileAccess="*uid://cs1k6ywveetut"
WebUtils="*uid://c7x2mf25lgvpr"
GlobalFileAccess="*uid://cy3tbxy52tuuv"
GlobalProjectManager="*uid://bo1q5s2r3hv4o"
TileConfigurationDatabase="*uid://l1owvvgnagbt"
SourceImagesDatabase="*uid://hq7a4qim3mmy"

[display]

window/size/mode=2
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_todo/plugin.cfg", "res://addons/line_edit_autocomplete_plugin/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
